  const params = new URLSearchParams(location.search);
  const q = (params.get('c')||'').toUpperCase();
  const saved = localStorage.getItem('apc26_code');
  if(q === TRIP_CODE || saved === TRIP_CODE){
    afterCodeOk();
  } else if(q){
    $('codeInput').value = q;
  }
  $('codeInput').addEventListener('keydown', e=>{ if(e.key==='Enter') tryCode(); });
})();
