<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#0f172a">
<title>APC Kiawah 2026 · Live</title>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-database-compat.js"></script>
<style>
  :root { --safe-b: env(safe-area-inset-bottom, 0px); }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; overscroll-behavior: none; }
  .tab-bar { padding-bottom: calc(0.5rem + var(--safe-b)); }
  .big-btn { min-height: 3.25rem; min-width: 3.25rem; }
  .score-btn { width: 3.5rem; height: 3.5rem; font-size: 1.75rem; font-weight: 700; }
  .card { background: #1e293b; border-radius: 1rem; }
  .net { color: #34d399; font-size: 0.85rem; }
  .live-dot { width: 8px; height: 8px; border-radius: 50%; background: #34d399; display: inline-block; animation: pulse 1.5s infinite; }
  .live-dot.off { background: #64748b; animation: none; }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.4} }
</style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen pb-24">

<!-- CODE GATE -->
<div id="gate" class="fixed inset-0 z-50 bg-slate-950 flex flex-col items-center justify-center p-6">
  <div class="text-center mb-8">
    <div class="text-4xl mb-2">⛳</div>
    <h1 class="text-2xl font-bold">APC Kiawah 2026</h1>
    <p class="text-slate-400 mt-1">Live scoring · Boys Golf Trip</p>
  </div>
  <input id="codeInput" type="text" placeholder="Enter trip code" maxlength="8"
    class="w-full max-w-xs text-center text-2xl tracking-widest uppercase bg-slate-800 border border-slate-600 rounded-xl py-4 px-4 outline-none focus:border-emerald-500"
    autocomplete="off" autocapitalize="characters">
  <button onclick="tryCode()" class="mt-4 w-full max-w-xs bg-emerald-600 hover:bg-emerald-500 text-white font-semibold py-4 rounded-xl text-lg">
    Join Trip
  </button>
  <p class="text-slate-500 text-sm mt-6">Code is remembered · scores sync live</p>
</div>

<!-- SETUP BANNER (shown if Firebase not configured) -->
<div id="setupBanner" class="hidden fixed inset-0 z-50 bg-slate-950/95 flex flex-col items-center justify-center p-6 overflow-y-auto">
  <div class="max-w-md w-full space-y-4">
    <h2 class="text-xl font-bold text-center">Enable Live Sync (one-time)</h2>
    <p class="text-sm text-slate-400 text-center">Free Firebase project · ~3 minutes · no logins for players</p>
    <ol class="text-sm space-y-3 list-decimal list-inside text-slate-300">
      <li>Go to <a class="text-sky-400 underline" href="https://console.firebase.google.com" target="_blank">console.firebase.google.com</a></li>
      <li>Create a project (name it anything, e.g. APC-Kiawah)</li>
      <li>Click <b>Realtime Database</b> → Create Database → start in <b>test mode</b></li>
      <li>Open the <b>Rules</b> tab and paste this, then Publish:
<pre class="bg-slate-900 p-2 rounded text-xs mt-1 overflow-x-auto">{
  "rules": {
    ".read": true,
    ".write": true
  }
}</pre>
      </li>
      <li>Project settings (gear) → Your apps → Web → register app → copy the <code>firebaseConfig</code> object</li>
      <li>Paste it below and tap Save</li>
    </ol>
    <textarea id="fbConfigInput" rows="8" placeholder='{
  apiKey: "...",
  authDomain: "...",
  databaseURL: "https://....firebaseio.com",
  projectId: "...",
  storageBucket: "...",
  messagingSenderId: "...",
  appId: "..."
}' class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-xs font-mono"></textarea>
    <button onclick="saveFirebaseConfig()" class="w-full bg-emerald-600 py-3 rounded-xl font-semibold">Save & Go Live</button>
    <button onclick="skipLive()" class="w-full text-slate-500 text-sm py-2">Use offline only (no sync)</button>
  </div>
</div>

<!-- APP -->
<div id="app" class="hidden">
  <header class="sticky top-0 z-40 bg-slate-900/95 backdrop-blur border-b border-slate-800 px-4 py-3 flex items-center justify-between">
    <div>
      <div class="font-bold text-lg leading-tight flex items-center gap-2">
        APC Kiawah
        <span id="liveStatus" class="text-xs font-normal text-slate-400 flex items-center gap-1">
          <span class="live-dot off" id="liveDot"></span><span id="liveLabel">offline</span>
        </span>
      </div>
      <div class="text-xs text-slate-400">Code: <span id="hdrCode" class="text-emerald-400 font-mono"></span></div>
    </div>
    <button onclick="shareTrip()" class="bg-slate-800 text-sm px-3 py-2 rounded-lg border border-slate-700">Share</button>
  </header>

  <main class="px-3 pt-3">
    <section id="screen-days" class="space-y-4">
      <h2 class="text-xl font-bold px-1">Schedule & Meals</h2>
      <div id="daysList"></div>
      <div class="card p-4">
        <h3 class="font-semibold mb-3">🍽️ Dinner Reservations</h3>
        <div id="mealsList" class="space-y-2 text-sm"></div>
      </div>
      <div class="card p-4">
        <h3 class="font-semibold mb-2">Matchups</h3>
        <div id="matchupEditor"></div>
      </div>
    </section>

    <section id="screen-score" class="hidden space-y-4">
      <div class="flex gap-2">
        <select id="roundSelect" onchange="onRoundChange()" class="flex-1 bg-slate-800 border border-slate-700 rounded-xl px-3 py-3 text-sm"></select>
        <select id="groupSelect" onchange="renderScoreEntry()" class="flex-1 bg-slate-800 border border-slate-700 rounded-xl px-3 py-3 text-sm"></select>
      </div>
      <div class="flex items-center justify-between px-1">
        <button onclick="prevHole()" class="big-btn bg-slate-800 rounded-xl px-4">◀</button>
        <div class="text-center">
          <div class="text-3xl font-bold" id="holeNum">1</div>
          <div class="text-xs text-slate-400" id="holeInfo">Par 4 · HCP 1</div>
        </div>
        <button onclick="nextHole()" class="big-btn bg-slate-800 rounded-xl px-4">▶</button>
      </div>
      <div id="scoreEntry" class="space-y-3"></div>
      <button onclick="clearHole()" class="w-full py-3 rounded-xl border border-red-800 text-red-400 text-sm">Clear this hole for group</button>
    </section>

    <section id="screen-board" class="hidden space-y-4">
      <div class="flex gap-2">
        <select id="boardRound" onchange="renderBoard()" class="flex-1 bg-slate-800 border border-slate-700 rounded-xl px-3 py-3 text-sm"></select>
      </div>
      <div id="boardContent"></div>
      <div class="card p-4">
        <h3 class="font-semibold mb-3">💰 Money Dashboard</h3>
        <div id="moneyDash" class="overflow-x-auto text-xs"></div>
      </div>
      <div class="card p-4">
        <h3 class="font-semibold mb-3">🏆 Trip Dashboard</h3>
        <div id="tripDash"></div>
      </div>
    </section>
  </main>

  <nav class="fixed bottom-0 left-0 right-0 bg-slate-900 border-t border-slate-800 tab-bar flex justify-around pt-2 z-40">
    <button onclick="showScreen('days')" id="tab-days" class="flex-1 flex flex-col items-center py-2 text-emerald-400">
      <span class="text-xl">📅</span><span class="text-xs mt-0.5">Days</span>
    </button>
    <button onclick="showScreen('score')" id="tab-score" class="flex-1 flex flex-col items-center py-2 text-slate-400">
      <span class="text-xl">✍️</span><span class="text-xs mt-0.5">Score</span>
    </button>
    <button onclick="showScreen('board')" id="tab-board" class="flex-1 flex flex-col items-center py-2 text-slate-400">
      <span class="text-xl">🏆</span><span class="text-xs mt-0.5">Board</span>
    </button>
  </nav>
</div>

<script>
// ========== FIREBASE CONFIG ==========
// Paste your config here OR use the setup screen (saved in localStorage)
let firebaseConfig = null;
try {
  const saved = localStorage.getItem('apc26_fb_config');
  if (saved) firebaseConfig = JSON.parse(saved);
} catch(e){}

const TRIP_CODE = 'APC26';
const PLAYERS = [
  { id:'luke',   name:'Luke',   team:1, hi:10.9 },
  { id:'dano',   name:'Dano',   team:1, hi:3.6  },
  { id:'bart',   name:'Bart',   team:1, hi:14.7 },
  { id:'marco',  name:'Marco',  team:1, hi:12.9 },
  { id:'little', name:'Little', team:2, hi:2.6  },
  { id:'julio',  name:'Julio',  team:2, hi:8.2  },
  { id:'jer',    name:'Jer',    team:2, hi:13.9 },
  { id:'dylan',  name:'Dylan',  team:2, hi:9.5  }
];
const TEAM_NAMES = {1:'Team Tremendous', 2:'Skin Monsters'};

const COURSES = {
  ocean: {
    name:'The Ocean Course', short:'Ocean',
    par:[4,5,4,4,3,4,5,3,4,4,5,4,4,3,4,5,3,4],
